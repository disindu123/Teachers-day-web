# Server: Node 22+; never put Admin credentials in public/ or commit .env.
NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=http://localhost:3000
# Direct Node: 0. Behind a single trusted proxy: 1 (see deployment notes).
TRUST_PROXY=0
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=replace-with-a-random-64-character-secret

# Copy from Firebase Console > Project settings > Your apps > Web app.
FB_PROJECT_ID=your-project-id
FB_WEB_API_KEY=your-web-api-key
FB_WEB_AUTH_DOMAIN=your-project-id.firebaseapp.com
FB_WEB_APP_ID=your-web-app-id
FB_WEB_MESSAGING_SENDER_ID=your-messaging-sender-id
# Use the exact bucket name shown in Firebase Storage (no gs:// prefix).
FB_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Admin credentials: choose ONE option, never all three.
# A) Local service account file outside this repository:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-repo/service-account.json
# B) Hosted secret containing the complete JSON (one line):
# FB_SERVICE_ACCOUNT_JSON={...}
# C) Individual hosted secrets (literal \n escapes are converted):
# FB_CLIENT_EMAIL=firebase-adminsdk-example@your-project-id.iam.gserviceaccount.com
# FB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Firebase/Google Cloud hosted service account:
# FB_USE_ADC=true

# Official channels: empty values produce disabled “coming soon” icons.
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=https://www.youtube.com/@SanghaboPahasara
SCHOOL_WEBSITE=https://srisanghabodhi.lk/
# Optional landscape logo (or replace public/assets/scmu-logo.svg).
LOGO_URL=
EVENT_DATE=2026-10-06T08:00:00+05:30
# Optional extra permitted browser origins, comma-separated exact origins.
ALLOWED_ORIGINS=
