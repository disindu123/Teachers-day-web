# Copy to .env for a local Node host. Never commit credentials.
NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 only behind a trusted, single-hop reverse proxy.
TRUST_PROXY=0

# Firebase Admin: use ONE option.
# A) Individual credentials (private-key newlines may be escaped as \n).
FB_PROJECT_ID=your-project-id
FB_CLIENT_EMAIL=firebase-adminsdk-example@your-project-id.iam.gserviceaccount.com
FB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# B) Alternatively, one compact JSON service-account secret:
# FB_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# C) Alternatively, a local file OUTSIDE public/:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# D) Google Cloud / Cloud Functions: use its attached service account:
# FB_USE_ADC=true

# Cloudinary Image and Video APIs Free plan. Keep the API secret SERVER ONLY.
CLOUDINARY_CLOUD_NAME=jxkhgqjq
CLOUDINARY_API_KEY=215673733495831
CLOUDINARY_API_SECRET="replace-with-your-cloudinary-api-secret"

# Firebase WEB config. These public identifiers are intentionally sent to browsers.
FB_WEB_API_KEY=your-web-api-key
FB_WEB_AUTH_DOMAIN=your-project-id.firebaseapp.com
FB_WEB_APP_ID=1:123456789:web:your-app-id
FB_WEB_MESSAGING_SENDER_ID=123456789

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=replace-with-a-random-64-character-secret

# Add your VERIFIED official SCMU profile URLs. Blank links stay disabled.
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=
SOCIAL_INSTAGRAM=
SCHOOL_WEBSITE=https://srisanghabodhi.lk/
# Optional confirmed event date/time, ISO format with Sri Lanka offset.
# Leave blank until confirmed; the site does not invent a schedule.
EVENT_DATE=
