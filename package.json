{
  "name": "scmu-sangabo-pahasara",
  "version": "2.0.0",
  "private": true,
  "description": "Sangabo Pahasara — Sanghabodhi College Media Unit",
  "type": "module",
  "main": "firebase.functions.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build-client.js",
    "postinstall": "npm run build",
    "test": "node --test tests/*.test.js",
    "admin": "node scripts/set-admin.js",
    "seed:slider": "node scripts/seed-slider.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cleanup:uploads": "node scripts/cleanup-uploads.js",
    "test:rules": "firebase emulators:exec --project demo-scmu --only firestore,storage \"node --test tests/rules.integration.js\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "firebase-tools": "^14.27.0",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "jwks-rsa": {
      "jose": "5.10.0"
    },
    "@grpc/grpc-js": "1.14.5"
  }
}
