rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /{collection}/{uid}/{filename} {
      // Authenticated admins upload directly, avoiding serverless request size limits.
      allow get: if collection in ['gallery', 'slider'];
      allow list: if admin();
      allow create: if admin() && request.auth.uid == uid
        && collection in ['gallery', 'slider']
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      // Immutable image objects prevent cache and registration races.
      allow update: if false;
      allow delete: if admin() && collection in ['gallery', 'slider'];
    }
  }
}
