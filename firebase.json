{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": ".",
      "codebase": "scmu",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".env*",
        "service-account*.json",
        "*serviceAccount*.json",
        "tests",
        "*.zip",
        "*.log"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "public": "hosting",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "README.txt"],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "web",
          "region": "asia-south1"
        }
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
